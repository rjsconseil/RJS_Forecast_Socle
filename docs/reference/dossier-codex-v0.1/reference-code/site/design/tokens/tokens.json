        "$description": "Texte sur fond clair — 17,55:1, le contraste inverse de celui du site."
      },
      "dim": {
        "$value": "#4a4a4a",
        "$type": "color",
        "$description": "Texte secondaire sur fond clair — 8,9:1."
      },
      "line": {
        "$value": "#c9c4b8",
        "$type": "color",
        "$description": "Filets sur fond clair — 2,4:1, décoratif."
      },
      "control": {
        "$value": "#8a8578",
        "$type": "color",
        "$description": "Bordures de champ — 3,3:1, seul cran conforme WCAG 1.4.11 sur ce fond."
      }
    },
    "veil": {
      "$value": "#050505",
      "$type": "color",
      "$description": "Fond derrière une surface d'édition. Opaque et non translucide : un voile semi-transparent laisse lire deux plans à la fois, ce qui fatigue et trompe."
    }
  },
