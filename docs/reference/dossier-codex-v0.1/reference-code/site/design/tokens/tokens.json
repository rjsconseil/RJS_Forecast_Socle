{
  "$description": "Tokens de design RJS Group — source de vérité, format DTCG. La PALETTE est reprise à l'identique de l'ancien site RJS Conseil (frontend/src/styles/_tokens.scss) : sombre, éditoriale, ivoire sur noir profond, accent vert. L'échelle typographique et les espacements, eux, restent ceux construits pour ce site. Généré vers src/styles/tokens.css par design/tokens/build.mjs — ne jamais éditer le CSS à la main.",
  "color": {
    "$description": "Reprise EXACTE de l'ancien site. Aucune valeur n'a été ajustée, y compris celles dont le contraste est faible : c'était la demande explicite de Roosevelt. Les ratios mesurés sont notés pour que les écarts soient connus, pas masqués.",
    "bg": {
      "default": {
        "$value": "#0a0a0a",
        "$type": "color",
        "$description": "fond principal, noir profond"
      },
      "alt": {
        "$value": "#0f0f0f",
        "$type": "color",
        "$description": "sections alternées"
      },
      "raised": {
        "$value": "#141414",
        "$type": "color",
        "$description": "carte, élément en élévation"
      },
      "sunken": {
        "$value": "#060606",
        "$type": "color",
        "$description": "Plus sombre que le fond : creuse la colonne des sous-sections révélées. Sur une palette sombre, on isole en creusant, jamais en éclairant — éclaircir ferait remonter la zone au premier plan et écraserait le titre."
      }
    },
    "fg": {
      "default": {
        "$value": "#f4f1ea",
        "$type": "color",
        "$description": "ivoire — texte principal. ~17.9:1 sur le fond."
      },
      "dim": {
        "$value": "rgba(244, 241, 234, 0.62)",
        "$type": "color",
        "$description": "texte secondaire"
      },
      "faint": {
        "$value": "rgba(244, 241, 234, 0.38)",
        "$type": "color",
        "$description": "métadonnées, étiquettes discrètes. ⚠ ~3.3:1 sur le fond : sous le seuil AA du texte courant. Conservé tel quel — réservé aux libellés non essentiels, jamais à une information qui n'existe nulle part ailleurs."
      },
      "muted": {
        "$value": "rgba(244, 241, 234, 0.30)",
        "$type": "color",
        "$description": "Liens mis en retrait pendant qu'une autre entité est survolée. Transitoire par nature : il ne s'applique jamais à un texte au repos, seulement le temps d'isoler la branche active. C'est l'ÉCART avec fg.default (17,55:1) qui porte l'information, pas la valeur elle-même."
      }
    },
    "line": {
      "subtle": {
        "$value": "rgba(255, 255, 255, 0.08)",
        "$type": "color",
        "$description": "filets discrets"
      },
      "strong": {
        "$value": "rgba(255, 255, 255, 0.14)",
        "$type": "color",
        "$description": "bordures appuyées : boutons, champs, focus"
      }
    },
    "accent": {
      "default": {
        "$value": "#3a6b50",
        "$type": "color",
        "$description": "vert profond. Le commentaire de l'ancien fichier annonçait « or champagne » — c'était une dérive entre le commentaire et la valeur, la couleur a toujours été verte."
      },
      "soft": {
        "$value": "rgba(58, 107, 80, 0.18)",
        "$type": "color",
        "$description": "aplat doux, survols et fonds d'accent"
      },
      "on": {
        "$value": "{color.fg.default}",
        "$type": "color",
        "$description": "ivoire sur aplat vert"
      },
      "note": {
        "$value": "{color.state.error}",
        "$type": "color",
        "$description": "filet d'annotation : ce qui manque, ce qui reste à faire. ALIAS de state.error, et volontairement : la palette est celle de l'ancien site RJS Conseil et n'est pas négociable — y ajouter une teinte serait une décision de design que Roosevelt n'a pas prise. Même teinte, deux intentions distinctes, assumé."
      }
    },
    "state": {
      "error": {
        "$value": "#c2543a",
        "$type": "color",
        "$description": "erreur d'interface uniquement — lisible sur fond sombre"
      },
      "success": {
        "$value": "{color.accent.default}",
        "$type": "color",
        "$description": "alias de l'accent : aucune teinte nouvelle"
      }
    },
    "selection": {
      "$value": "{color.accent.soft}",
      "$type": "color",
      "$description": "surlignage de sélection de texte"
    },
    "focus": {
      "$value": "{color.fg.default}",
      "$type": "color",
      "$description": "contour de focus — ivoire, le seul ton qui reste visible partout, y compris sur un aplat vert. Jamais outline:none."
    },
    "panel": {
      "bg": {
        "$value": "#f4f1ea",
        "$type": "color",
        "$description": "Fond des surfaces d'édition. Ivoire opaque : aucune transparence, la lecture prime sur l'effet."
      },
      "surface": {
        "$value": "#ffffff",
        "$type": "color",
        "$description": "Champs de saisie, sur le fond ivoire."
      },
      "fg": {
