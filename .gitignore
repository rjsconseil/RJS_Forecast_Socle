# Données JSON du site conservées avec la version de référence ; verrous et fichiers temporaires exclus.
api/data/**
!api/data/**/
!api/data/**/*.json
node_modules/
web/dist/

# Les sources JSON importées font partie de la sauvegarde complète du site.

# Fichiers du Finder (macOS) : réécrits à chaque ouverture d’un dossier, jamais versionnés.
.DS_Store

# Archives de données (anciennes sauvegardes JSON, copies avant migration) : restent sur le poste, jamais versionnées.
api/data/store.archives/
# Corbeille locale, captures de travail et copies faites par la synchronisation du dossier (« nom 2.ext »).
.trash/
output/
* 2.*
