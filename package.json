{
  "name": "rjs-forecast-socle",
  "private": true,
  "version": "0.4.0",
  "description": "RJS Forecast — socle (Object Management, noyau), middlewares Budget et Patrimoine, application BPM (API locale + site Angular)",
  "type": "module",
  "scripts": {
    "start": "node scripts/start.mjs",
    "start:production": "node scripts/start.mjs --production",
    "api": "node api/src/server.mjs",
    "api:recette": "J1_ENABLE_RECETTE_RESET=1 node api/src/server.mjs",
    "web": "npm --prefix web start",
    "seed": "node api/scripts/seed.mjs",
    "seed:plafonds": "node api/scripts/seed-plafonds.mjs",
    "seed:projets": "node api/scripts/seed-projets.mjs",
    "seed:bpm-functional": "node api/scripts/seed-bpm-functional.mjs",
    "import:rjs-forecast": "node api/scripts/import-rjs-forecast.mjs",
    "test": "node --test 'api/test/*.test.mjs'",
    "e2e:projets": "node e2e/projets.e2e.mjs",
    "e2e:bpm": "node e2e/bpm-navigation.e2e.mjs",
    "build": "npm --prefix web run build",
    "e2e:astra": "node e2e/astra.e2e.mjs",
    "styles:audit": "node scripts/styles-audit.mjs",
    "api:check": "node scripts/api-check.mjs",
    "fixtures:web": "node api/scripts/web-fixtures.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "playwright-core": "^1.65.1"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
